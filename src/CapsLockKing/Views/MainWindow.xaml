<ui:FluentWindow x:Class="CapsLockKing.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="CapsLock King"
                 Width="860"
                 Height="820"
                 MinWidth="620"
                 MinHeight="480"
                 Background="#FF1B1B1B"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!-- แถวในตาราง mapping -->
        <DataTemplate x:Key="MappingRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Height="32"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left"
                           Content="{Binding KeyLabel}"
                           Tag="{Binding}"
                           Click="CaptureKey_Click"
                           ToolTip="กดเพื่อจับคีย์จริงจากคีย์บอร์ด" />

                <TextBlock Grid.Column="1"
                           Text="→"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PageSubtleTextBrush}" />

                <ui:TextBox Grid.Column="2"
                            Height="32"
                            VerticalContentAlignment="Center"
                            Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="เช่น ctrl+c, left, f5" />

                <ui:Button Grid.Column="3"
                           Height="32"
                           Margin="8,0,0,0"
                           Content="จับ combo"
                           Tag="{Binding}"
                           Click="CaptureCombo_Click" />

                <ui:Button Grid.Column="4"
                           Height="32"
                           Margin="8,0,0,0"
                           Width="36"
                           Padding="0"
                           Content="✕"
                           Appearance="Danger"
                           Tag="{Binding}"
                           Click="DeleteRow_Click"
                           ToolTip="ลบ mapping นี้" />
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="CapsLock King — ตั้งค่า"
                     ShowMaximize="False"
                     ShowMinimize="True" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="18,0,18,6">
            <StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ปุ่ม CapsLock" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="แตะ CapsLock เดี่ยวแล้วจะส่งคีย์นี้"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="TapButton"
                                       MinWidth="150"
                                       Height="32"
                                       HorizontalContentAlignment="Left"
                                       Click="CaptureTap_Click"
                                       ToolTip="กดเพื่อจับคีย์จริง" />
                            <ui:Button Content="ล้าง"
                                       Height="32"
                                       Margin="8,0,0,0"
                                       Click="ClearTap_Click" />

                            <TextBlock Text="ปล่อย Esc เมื่อกดค้างเกิน"
                                       VerticalAlignment="Center"
                                       Margin="32,0,8,0"
                                       Foreground="{StaticResource PageSubtleTextBrush}" />
                            <ui:TextBox x:Name="TimeoutBox"
                                        Width="72"
                                        Height="32"
                                        Text="0"
                                        VerticalContentAlignment="Center" />
                            <TextBlock Text="ms"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="{StaticResource PageSubtleTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="คีย์ลัด (CapsLock + …)" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="กดปุ่มทางซ้ายเพื่อจับคีย์จริง หรือพิมพ์ action เองในช่องก็ได้"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,4,0,12" />

                        <ItemsControl x:Name="MappingList"
                                      ItemTemplate="{StaticResource MappingRowTemplate}">
                            <ItemsControl.ItemContainerStyle>
                                <!-- ให้แต่ละแถวยืดเต็มความกว้าง ไม่งั้น star column จะดันแถวทะลุขอบ -->
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button Content="＋ เพิ่ม mapping"
                                       Height="32"
                                       Click="AddRow_Click" />
                            <ui:Button Content="โหลดจากไฟล์"
                                       Height="32"
                                       Margin="8,0,0,0"
                                       Click="Reload_Click" />
                            <ui:Button Content="ค่าเริ่มต้น"
                                       Height="32"
                                       Margin="8,0,0,0"
                                       Click="Defaults_Click" />
                            <ui:Button Content="เปิด JSON"
                                       Height="32"
                                       Margin="8,0,0,0"
                                       Click="OpenJson_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="18,0,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PageSubtleTextBrush}" />

            <ui:Button Grid.Column="1"
                       Content="บันทึก &amp; ใช้"
                       Appearance="Primary"
                       Height="36"
                       MinWidth="140"
                       Click="Save_Click" />
            <ui:Button Grid.Column="2"
                       Content="ปิด"
                       Height="36"
                       MinWidth="80"
                       Margin="8,0,0,0"
                       Click="Close_Click" />
        </Grid>

        <!-- overlay จับคีย์ -->
        <Grid x:Name="CaptureOverlay"
              Grid.RowSpan="3"
              Background="#B3000000"
              Visibility="Collapsed">
            <Border Background="#FF2A2A2A"
                    CornerRadius="12"
                    Padding="26"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="CaptureTitle"
                               Text="กดปุ่มบนคีย์บอร์ด"
                               Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureHint"
                               Style="{StaticResource HintStyle}"
                               Margin="0,8,0,18" />
                    <ui:Button Content="ยกเลิก"
                               HorizontalAlignment="Right"
                               Click="CancelCapture_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
