<ui:FluentWindow x:Class="OpenKey.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="OpenKey"
                 Width="980"
                 Height="760"
                 MinWidth="760"
                 MinHeight="520"
                 Background="#FF1B1B1B"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="TriggerItemTemplate">
            <StackPanel Margin="4,3">
                <TextBlock Text="{Binding Key}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PageTextBrush}" />
                <TextBlock Text="{Binding TapLabel}"
                           FontSize="11"
                           Foreground="{StaticResource PageSubtleTextBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MapRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Height="32"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left"
                           Content="{Binding FromLabel}"
                           Tag="{Binding}"
                           Click="MapFrom_Click"
                           ToolTip="กดคีย์จริงเพื่อกำหนดปุ่มที่ใช้ร่วมกับ trigger" />
                <TextBlock Grid.Column="1"
                           Text="→"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PageSubtleTextBrush}" />
                <ui:TextBox Grid.Column="2"
                            Height="32"
                            VerticalContentAlignment="Center"
                            Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="เช่น left, ctrl+c, win+ctrl+right" />
                <ui:Button Grid.Column="3"
                           Height="32"
                           Margin="8,0,0,0"
                           Content="จับ combo"
                           Tag="{Binding}"
                           Click="MapTo_Click" />
                <ui:Button Grid.Column="4"
                           Height="32"
                           Width="36"
                           Margin="8,0,0,0"
                           Padding="0"
                           Content="✕"
                           Appearance="Danger"
                           Tag="{Binding}"
                           Click="DeleteMap_Click"
                           ToolTip="ลบแถวนี้" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DirectRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Height="32"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left"
                           Content="{Binding FromLabel}"
                           Tag="{Binding}"
                           Click="DirectFrom_Click"
                           ToolTip="กดคีย์จริง (กด modifier ค้างได้)" />
                <TextBlock Grid.Column="1"
                           Text="→"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PageSubtleTextBrush}" />
                <ui:TextBox Grid.Column="2"
                            Height="32"
                            VerticalContentAlignment="Center"
                            Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="เช่น win, ctrl+shift+escape" />
                <ui:Button Grid.Column="3"
                           Height="32"
                           Margin="8,0,0,0"
                           Content="จับ combo"
                           Tag="{Binding}"
                           Click="DirectTo_Click" />
                <ui:Button Grid.Column="4"
                           Height="32"
                           Width="36"
                           Margin="8,0,0,0"
                           Padding="0"
                           Content="✕"
                           Appearance="Danger"
                           Tag="{Binding}"
                           Click="DeleteDirect_Click"
                           ToolTip="ลบแถวนี้" />
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="OpenKey — ตั้งค่า"
                     ShowMaximize="False"
                     ShowMinimize="True" />

        <!-- triggers + mappings -->
        <Grid Grid.Row="1" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Triggers" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="คีย์ที่กดค้างแล้วเปลี่ยนความหมายของคีย์อื่น"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,4,0,10" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="TriggerList"
                             Style="{StaticResource TriggerListStyle}"
                             ItemTemplate="{StaticResource TriggerItemTemplate}"
                             SelectionChanged="TriggerList_SelectionChanged" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="＋ เพิ่ม trigger" Height="32" Click="AddTrigger_Click" />
                        <ui:Button Content="ลบ" Height="32" Margin="8,0,0,0" Click="DeleteTrigger_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="MapHeader"
                                   Text="เลือก trigger ทางซ้าย"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="กดคีย์ซ้ายเพื่อจับคีย์จริง หรือพิมพ์ action เองก็ได้"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,4,0,10" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="แตะเดี่ยว →"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PageSubtleTextBrush}" />
                        <ui:Button x:Name="TapButton"
                                   MinWidth="140"
                                   Height="32"
                                   Margin="10,0,0,0"
                                   HorizontalContentAlignment="Left"
                                   Content="(ไม่ทำอะไร)"
                                   Click="CaptureTap_Click" />
                        <ui:Button Content="ล้าง" Height="32" Margin="8,0,0,0" Click="ClearTap_Click" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MapList" ItemTemplate="{StaticResource MapRowTemplate}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>

                    <ui:Button Grid.Row="3"
                               Content="＋ เพิ่มคีย์"
                               Height="32"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Left"
                               Click="AddMap_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- direct mappings -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="18,0,18,0" MaxHeight="220">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Direct mappings" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="map ตรง ๆ ไม่ต้องกด trigger ค้าง — เช่น alt → win"
                               Style="{StaticResource HintStyle}"
                               Margin="0,4,0,10" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DirectList" ItemTemplate="{StaticResource DirectRowTemplate}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>

                <ui:Button Grid.Row="2"
                           Content="＋ เพิ่ม mapping"
                           Height="32"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Left"
                           Click="AddDirect_Click" />
            </Grid>
        </Border>

        <!-- footer -->
        <Grid Grid.Row="3" Margin="18,12,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PageSubtleTextBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="tapTimeout"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PageSubtleTextBrush}" />
                <ui:TextBox x:Name="TimeoutBox"
                            Width="70"
                            Height="32"
                            Margin="8,0,6,0"
                            Text="0"
                            VerticalContentAlignment="Center"
                            ToolTip="0 = แตะแล้วได้ tap ทุกครั้ง / >0 = ต้องปล่อยภายในเวลานี้" />
                <TextBlock Text="ms"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PageSubtleTextBrush}" />
            </StackPanel>

            <ui:Button Grid.Column="2"
                       Content="บันทึก &amp; ใช้"
                       Appearance="Primary"
                       Height="36"
                       MinWidth="140"
                       Click="Save_Click" />
            <ui:Button Grid.Column="3"
                       Content="ปิด"
                       Height="36"
                       MinWidth="80"
                       Margin="8,0,0,0"
                       Click="Close_Click" />
        </Grid>

        <!-- overlay จับคีย์ -->
        <Grid x:Name="CaptureOverlay"
              Grid.RowSpan="4"
              Background="#B3000000"
              Visibility="Collapsed">
            <Border Background="#FF2A2A2A"
                    CornerRadius="12"
                    Padding="26"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="CaptureTitle"
                               Text="กดปุ่มบนคีย์บอร์ด"
                               Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureHint"
                               Style="{StaticResource HintStyle}"
                               Margin="0,8,0,18" />
                    <ui:Button Content="ยกเลิก"
                               HorizontalAlignment="Right"
                               Click="CancelCapture_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
